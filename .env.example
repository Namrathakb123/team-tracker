# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git. Never put real values in this file.

# Firebase Admin service account: the server's key to the database and the logins
# (Firebase console > Project settings > Service accounts > Generate new private key).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes, and keep the \n markers exactly as they appear in the downloaded JSON key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase web app settings, used by the sign-in page (Firebase console > Project settings > General > Your apps).
# They name the project; they are not secret.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Only for moving the old data out of MongoDB into Firebase (npm run move-to-firebase), and for taking a fresh test
# copy of it (npm run dev:local -- --fresh). The app itself doesn't use it. Delete it once the move is done.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/velvo?retryWrites=true&w=majority
